# Cloud SQL connection template for minEA
# Instance connection name: minea-a1d4c:us-central1:minea-a1d4c-2-instance
# Public IP: 34.41.177.66

# ─── Firebase Admin ──────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=minea-a1d4c
FIREBASE_CREDENTIALS_PATH=./fb_svc_acct.json
# Vercel / production: paste the full JSON string (no file on disk)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── Database (pick one) ─────────────────────────────────────────────────────
# A) Public IP — add your IP to Cloud SQL authorized networks first
# Instance name: minea-a1d4c-2-instance  |  Database name: usually "postgres"
DATABASE_URL=postgresql+asyncpg://hminhas:YOUR_PASSWORD@34.41.177.66:5432/postgres
DATABASE_SSL=true
# Vercel + Cloud SQL: default CA bundle cannot verify Cloud SQL certs.
# Quick fix: DATABASE_SSL_VERIFY=false  (TLS encrypted, server not verified)
# Better: download server-ca.pem from Cloud SQL → Connections → paste as DATABASE_SSL_CA

# B) Cloud SQL Auth Proxy — run `npm run db:proxy` in another terminal, then use:
# DATABASE_URL=postgresql+asyncpg://hminhas:YOUR_PASSWORD@127.0.0.1:5432/postgres

# ─── Google Gemini (AI chat, insights, ingestion) ────────────────────────────
# Local: set in this file. Vercel: Project → Settings → Environment Variables.
# Get a key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# Cheaper alternative: gemini-2.5-flash-lite
# Note: gemini-2.0-flash was retired 2026-06-01.

# ─── App ─────────────────────────────────────────────────────────────────────
DEBUG=true
WEB_APP_URL=http://localhost:3000
# Signs email-verification links (recommended in production; falls back to RESEND_API_KEY if unset)
# APP_SECRET=long-random-string

# Local Python deps: pip install -r requirements-dev.txt  (adds uvicorn, alembic, psycopg2 for dev/migrate)

# Vercel: add your web app URL, e.g. https://minea-web.vercel.app
# CORS_ORIGINS=["http://localhost:3000","https://minea-web.vercel.app"]

# ─── Stripe (self-serve packs: Starter / Team / Business) ────────────────────
# Everything Stripe is OFF unless STRIPE_SECRET_KEY is set. See docs/stripe-billing.md.
# Products, prices (lookup_key bubomap_<plan>_<interval>) and portal configs come from
#   python scripts/stripe_bootstrap.py --key-env STRIPE_SECRET_KEY
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # endpoint: <API or web origin>/api/v1/webhooks/stripe
#                                   # or: stripe listen --forward-to localhost:8000/api/v1/webhooks/stripe
# With a TEST key, only these org slugs can check out or be changed by webhooks (shared DB!):
# STRIPE_TEST_ORG_SLUGS=qa-sso-test
# Paid plans are "coming soon" (checkout 403 paid_plans_coming_soon) unless opened:
#   STRIPE_CHECKOUT_ORG_SLUGS set  -> only those orgs may start checkout (even with OPEN=1)
#   else STRIPE_CHECKOUT_OPEN=1    -> every org may start checkout
#   else (default)                 -> nobody. Subscribed orgs keep Manage billing either way.
# STRIPE_CHECKOUT_ORG_SLUGS=qa-sso-test
# STRIPE_CHECKOUT_OPEN=1
# Stripe Tax on Checkout (needs Stripe Tax set up in the Dashboard first). Default off.
# STRIPE_AUTOMATIC_TAX=1

# ─── Email (Resend) — verification emails and org/workspace invites ──
# RESEND_API_KEY=re_...
# EMAIL_FROM=minEA <noreply@yourdomain.com>
# EMAIL_FROM=minEA <noreply@yourdomain.com>
