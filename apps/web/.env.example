# ─── Firebase (client — safe to expose in browser) ───────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Browser calls /api/v1/* on this app; Next.js proxies to API_URL at request time.
# Production (Vercel web project): https://min-ea-api.vercel.app
API_URL=http://localhost:8000

# Shown on Solo upgrade card in org settings (e.g. $29/month)
# NEXT_PUBLIC_SOLO_PRICE_LABEL=$29/month

# Pricing page + admin centre (Plan & billing, Licences, Onboarding). Display only.
# Unset = on in local dev, OFF in production builds. Set to 1 on Vercel to launch, 0 to hide.
# NEXT_PUBLIC_BILLING_UI=1

# Booking link for the 4 onboarding hours on Team and Business (e.g. a Calendly URL).
# Unset = the card says "Booking link coming soon".
# NEXT_PUBLIC_ONBOARDING_BOOKING_URL=https://calendly.com/your-link

# ─── Database (API only — put in apps/api/.env) ───────────────────────────────
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/minea

# ─── Firebase Admin (API only — put in apps/api/.env) ───────────────────────
# FIREBASE_PROJECT_ID=minea-a1d4c
# FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
